options:
  parameters:
    author: DISCRAFT
    catch_exceptions: 'True'
    category: '[Core]'
    comment: 'HD digital voice transceiver for ADALM-Pluto: 16 kHz mono Opus 16 kbps CBR, CRC32, K=7 rate-1/2 convolutional FEC, interleaving, Gray differential QPSK, RRC pulse shaping.'
    description: 'Low-latency digital voice walkie-talkie for ADALM-Pluto'
    gen_cmake: 'On'
    generate_options: qt_gui
    hier_block_src_path: .
    id: pluto_digital_voice_hd_qpsk
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    realtime_scheduling: '1'
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: 'False'
    title: Pluto Digital Voice HD - Opus/QPSK/FEC
    window_size: (1800,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [10,10]
    rotation: 0
    state: enabled

