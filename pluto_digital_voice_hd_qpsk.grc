- name: tx_limiter
  id: epy_block
  parameters:
    _source_code: "import numpy as np
from gnuradio import gr
class blk(gr.sync_block):
    def __init__(self):
        gr.sync_block.__init__(self,name='Speech Soft Limiter',in_sig=[np.float32],out_sig=[np.float32])
        self.drive=1.8
        self.norm=np.tanh(self.drive)
    def work(self,input_items,output_items):
        output_items[0][:]=np.tanh(self.drive*input_items[0])/self.norm
        return len(output_items[0])
"
    affinity: ''
    alias: ''
    comment: 'Soft limiter'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    coordinate: [1150,80]
    rotation: 0
    state: enabled
- name: opus_enc
  id: epy_block
  parameters:
    _source_code: "import numpy as np
from gnuradio import gr
import opuslib
class blk(gr.basic_block):
    def __init__(self):
        gr.basic_block.__init__(self,name='Opus 16k 16kbps CBR Encoder',in_sig=[np.float32],out_sig=[np.uint8])
        self.rate=16000; self.frame=320; self.packet_bytes=40
        self.buf=np.empty(0,dtype=np.float32)
        self.enc=opuslib.Encoder(self.rate,1,opuslib.APPLICATION_VOIP)
        self.enc.bitrate=16000
        self.enc.vbr=False
        try: self.enc.complexity=10
        except Exception: pass
    def general_work(self,input_items,output_items):
        x=input_items[0]
        if len(x):
            self.buf=np.concatenate((self.buf,x.astype(np.float32,copy=False)))
            self.consume(0,len(x))
        out=output_items[0]
        nframes=min(len(self.buf)//self.frame,len(out)//self.packet_bytes)
        if nframes<=0: return 0
        p=0; c=0
        for _ in range(nframes):
            pcm=np.clip(self.buf[c:c+self.frame],-1.0,1.0)
            packet=self.enc.encode((pcm*32767.0).astype(np.int16).tobytes(),self.frame)
            if len(packet)!=self.packet_bytes:
                raise RuntimeError('Opus CBR packet is not 40 bytes')
            out[p:p+40]=np.frombuffer(packet,dtype=np.uint8)
            p+=40; c+=self.frame
        self.buf=self.buf[c:]
        return p
"
    affinity: ''
    alias: ''
    comment: 'Opus 16 kbps CBR, 20 ms frames'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    coordinate: [1320,80]
    rotation: 0
    state: enabled
- name: fec_tx
  id: epy_block
  parameters:
    _source_code: "import numpy as np
import zlib
from gnuradio import gr
SYNC=0x1ACFFC1D; G0=0o171; G1=0o133
def bits(b): return np.unpackbits(np.frombuffer(b,dtype=np.uint8),bitorder='big').astype(np.uint8)
def enc(x):
    s=0; o=[]
    for b in x:
        r=((s<<1)|int(b))&0x7f
        o += [(r&G0).bit_count()&1,(r&G1).bit_count()&1]
        s=r&0x3f
    for _ in range(6):
        r=(s<<1)&0x7f
        o += [(r&G0).bit_count()&1,(r&G1).bit_count()&1]
        s=r&0x3f
    return np.asarray(o,dtype=np.uint8)
class blk(gr.basic_block):
    def __init__(self):
        gr.basic_block.__init__(self,name='CRC32 FEC Framer',in_sig=[np.uint8],out_sig=[np.uint8])
        self.buf=bytearray(); self.seq=0
    def general_work(self,input_items,output_items):
        x=input_items[0]
        if len(x):
            self.buf.extend(bytes(x.tolist())); self.consume(0,len(x))
        out=output_items[0]; nf=min(len(self.buf)//40,len(out)//98)
        if nf<=0: return 0
        p=0
        sync=np.array([(SYNC>>i)&1 for i in range(31,-1,-1)],dtype=np.uint8)
        for _ in range(nf):
            payload=bytes(self.buf[:40]); del self.buf[:40]
            hdr=(self.seq&0xffff).to_bytes(2,'big')
            crc=zlib.crc32(hdr+payload).to_bytes(4,'big')
            coded=enc(bits(hdr+payload+crc))
            coded=coded.reshape(22,34).T.flatten()
            frame=np.concatenate((sync,coded,np.zeros(4,dtype=np.uint8)))
            out[p:p+98]=np.packbits(frame,bitorder='big'); p+=98
            self.seq=(self.seq+1)&0xffff
        return p
"
    affinity: ''
    alias: ''
    comment: 'CRC32 + K=7 rate-1/2 convolutional FEC + 22x34 bit interleaver'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    coordinate: [1490,80]
    rotation: 0
    state: enabled
