- name: fec_rx
  id: epy_block
  parameters:
    _source_code: "import numpy as np
import zlib
from gnuradio import gr
SYNC=0x1ACFFC1D; G0=0o171; G1=0o133
def tables():
    n=np.zeros((64,2),dtype=np.uint8); a=np.zeros((64,2),dtype=np.uint8); b=np.zeros((64,2),dtype=np.uint8)
    for s in range(64):
        for bit in (0,1):
            r=((s<<1)|bit)&0x7f; n[s,bit]=r&0x3f
            a[s,bit]=(r&G0).bit_count()&1; b[s,bit]=(r&G1).bit_count()&1
    return n,a,b
NEXT,O0,O1=tables()
def vit(c):
    ns=len(c)//2; INF=10**9
    m=np.full(64,INF,dtype=np.int32); m[0]=0
    ps=np.zeros((ns,64),dtype=np.int8); pb=np.zeros((ns,64),dtype=np.int8)
    for t in range(ns):
        r0=int(c[2*t]); r1=int(c[2*t+1]); nm=np.full(64,INF,dtype=np.int32)
        for s in range(64):
            if m[s]>=INF: continue
            for bit in (0,1):
                q=int(NEXT[s,bit]); bm=(int(O0[s,bit])!=r0)+(int(O1[s,bit])!=r1)
                v=int(m[s])+bm
                if v<int(nm[q]):
                    nm[q]=v; ps[t,q]=s; pb[t,q]=bit
        m=nm
    if m[0]>=INF: return None,INF
    bits=np.zeros(ns,dtype=np.uint8); s=0
    for t in range(ns-1,-1,-1):
        bits[t]=pb[t,s]; s=int(ps[t,s])
    return bits,int(m[0])
class blk(gr.basic_block):
    def __init__(self):
        gr.basic_block.__init__(self,name='FEC Deframer + Viterbi',in_sig=[np.uint8],out_sig=[np.uint8])
        self.buf=bytearray(); self.expected=None
    def general_work(self,input_items,output_items):
        x=input_items[0]
        if len(x):
            self.buf.extend(bytes(x.tolist())); self.consume(0,len(x))
        out=output_items[0]; made=0
        while len(self.buf)>=98 and made+42<=len(out):
            frame=np.unpackbits(np.frombuffer(bytes(self.buf[:98]),dtype=np.uint8),bitorder='big')
            if not np.array_equal(frame[:32],np.array([(SYNC>>i)&1 for i in range(31,-1,-1)],dtype=np.uint8)):
                del self.buf[0]; continue
            c=frame[32:32+748].reshape(34,22).T.flatten()
            d,metric=vit(c)
            if d is None or metric>80:
                del self.buf[0]; continue
            raw=np.packbits(d[:368],bitorder='big').tobytes()
            seq=raw[:2]; payload=raw[2:42]; crc=raw[42:46]
            if len(raw)<46 or zlib.crc32(seq+payload).to_bytes(4,'big')!=crc:
                del self.buf[0]; continue
            out[made:made+42]=np.frombuffer(seq+payload,dtype=np.uint8); made+=42
            del self.buf[:98]
        return made
"
    affinity: ''
    alias: ''
    comment: 'Sync + inverse interleaver + Viterbi + CRC32'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    coordinate: [980,360]
    rotation: 0
    state: enabled
- name: opus_dec
  id: epy_block
  parameters:
    _source_code: "import numpy as np
from gnuradio import gr
import opuslib
class blk(gr.basic_block):
    def __init__(self):
        gr.basic_block.__init__(self,name='Opus 16k Decoder + PLC',in_sig=[np.uint8],out_sig=[np.float32])
        self.rate=16000; self.frame=320; self.packet=42; self.buf=bytearray(); self.expected=None
        self.dec=opuslib.Decoder(self.rate,1); self.audio=np.empty(0,dtype=np.float32)
    def general_work(self,input_items,output_items):
        x=input_items[0]
        if len(x):
            self.buf.extend(bytes(x.tolist())); self.consume(0,len(x))
        while len(self.buf)>=self.packet:
            raw=bytes(self.buf[:self.packet]); del self.buf[:self.packet]
            seq=int.from_bytes(raw[:2],'big'); pkt=raw[2:]
            try:
                if self.expected is None: self.expected=seq
                gap=(seq-self.expected)&0xffff
                if gap>32768: continue
                for _ in range(gap):
                    plc=self.dec.decode(b'',self.frame)
                    self.audio=np.concatenate((self.audio,np.frombuffer(plc,dtype=np.int16).astype(np.float32)/32767.0))
                pcm=self.dec.decode(pkt,self.frame)
                self.audio=np.concatenate((self.audio,np.frombuffer(pcm,dtype=np.int16).astype(np.float32)/32767.0))
                self.expected=(seq+1)&0xffff
            except Exception:
                pass
        out=output_items[0]; n=min(len(out),len(self.audio))
        if n:
            out[:n]=self.audio[:n]; self.audio=self.audio[n:]
        return n
"
    affinity: ''
    alias: ''
    comment: 'Sequence-aware Opus decoder with packet-loss concealment'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    coordinate: [1170,360]
    rotation: 0
    state: enabled
