options:
  parameters:
    author: DISCRAFT
    catch_exceptions: 'True'
    category: DISCRAFT Pluto SDR
    cmake_opt: ''
    comment: FINAL canonical PlutoSDR digital voice flowgraph. This file is intentionally
      self-identifying as DISCRAFT FINAL and contains no samp_rate=32000 variable.
    copyright: ''
    description: High-quality low-latency digital voice transceiver for ADALM-Pluto
      with live RF spectrum, QPSK constellation, FLL, audio waveform and power monitoring.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: .
    id: pluto_discraft_digital_voice_final
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: DISCRAFT Pluto Digital Voice - FINAL
    window_size: (1800, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [0, 1568.0]
    domain: std
    pythread: false
    realtime_scheduling: '1'
    rotation: 0
    run: true
    run_on: ''
    state: enabled
    thread_safe_setters: false
    title: DISCRAFT Pluto Digital Voice - FINAL
    translation_language: none

