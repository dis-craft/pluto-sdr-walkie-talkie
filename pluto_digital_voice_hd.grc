- name: tx_limiter
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Low-latency soft limiter for speech.\"\"\"\n    def __init__(self):\n\
      \        gr.sync_block.__init__(self,\n            name=\"speech_soft_limiter\"\
      ,\n            in_sig=[np.float32],\n            out_sig=[np.float32])\n   \
      \     self.drive = 1.8\n        self.norm = np.tanh(self.drive)\n\n    def work(self,\
      \ input_items, output_items):\n        x = input_items[0]\n        y = output_items[0]\n\
      \        y[:] = np.tanh(self.drive * x) / self.norm\n        return len(y)\n"
    affinity: ''
    alias: ''
    comment: Prevents clipping and evens speech level.
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('speech_soft_limiter', 'blk', [], [('0', 'float', 1)], [('0', 'float',
      1)], 'Low-latency soft limiter for speech.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 120.0]
    rotation: 0
    state: enabled
