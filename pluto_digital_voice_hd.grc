options:
  parameters:
    author: DISCRAFT
    catch_exceptions: 'True'
    category: 'DISCRAFT Pluto SDR'
    comment: 'FINAL canonical PlutoSDR digital voice flowgraph. This file is intentionally self-identifying as DISCRAFT FINAL and contains no samp_rate=32000 variable.'
    description: High-quality low-latency digital voice transceiver for ADALM-Pluto with live RF spectrum, QPSK constellation, FLL, audio waveform and power monitoring.
    enable_cache: 'True'
    gen_cmake: 'On'
    generate_options: qt_gui
    hier_block_src_path: .
    id: pluto_discraft_digital_voice_final
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    redraw: 'True'
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: 'False'
    title: DISCRAFT Pluto Digital Voice - FINAL
    window_size: (1800, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 20.0]
    domain: std
    pythread: false
    realtime_scheduling: '1'
    run: true
    run_on: ''
    translation_language: none
    thread_safe_setters: false
    title: DISCRAFT Pluto Digital Voice - FINAL
